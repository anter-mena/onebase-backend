# Copy to .env (git-ignored) for local runs and fill in your own values.
# Start the local database first:  docker compose -f compose.dev.yml up -d

SWAGGER_USERNAME=onebase
SWAGGER_PASSWORD=change-me

DB_URL=jdbc:postgresql://localhost:5432/onebase
DB_USERNAME=onebase
DB_PASSWORD=change-me

# At least 32 random characters.
JWT_SECRET=change-me-to-at-least-32-random-characters

# First account on an empty database.
BOOTSTRAP_OWNER_NAME=Your Name
BOOTSTRAP_OWNER_EMAIL=you@example.com
BOOTSTRAP_OWNER_PASSWORD=change-me

FRONTEND_URL=http://localhost:3000
