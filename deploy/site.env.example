# Per-server settings. Copy to /opt/onebase/site.env on the VPS (never in git).
# deploy.sh adds it to .env on every deploy. No site.env = the old behaviour:
# backend public on 8080, no Caddy, no backups.

# Turn on HTTPS (Caddy), the daily database backup and n8n (automation).
COMPOSE_PROFILES=https,backup,automation

# The backend's address. Its DNS A record must point at this VPS.
API_DOMAIN=api.onebase.live

# n8n's address (automation profile). Its DNS A record must point at this VPS.
N8N_DOMAIN=n8n.onebase.live

# Only this machine reaches port 8080; everyone else goes through Caddy on 443.
BACKEND_BIND=127.0.0.1
