# HTTPS for the backend. API_DOMAIN comes from site.env (e.g. api.onebase.live).
# Caddy gets the certificate itself; the DNS record must point at this VPS first.
{
	servers {
		# Every call comes from the frontend's servers (Vercel), which put the person's own
		# IP first in X-Forwarded-For. Keep it, so the action log and the sessions list show
		# the person and not Vercel. Vercel's addresses are not fixed, so none can be listed.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8080
}

# n8n (2026-10-28) where site.env turns it on: N8N_DOMAIN=n8n.onebase.live, with its DNS
# A record on this VPS. Elsewhere a local name nobody reaches.
{$N8N_DOMAIN} {
	encode zstd gzip
	# Never in a search engine.
	header X-Robots-Tag "noindex, nofollow"
	# A browser password in front of the editor (2026-10-28), from a file kept only on the
	# server (/opt/onebase/caddy-auth/n8n.caddy, see ACCESS.md). Google's scanner flagged the
	# site as "dangerous" on seeing n8n's sign-in page, as it does with copies used for
	# phishing; behind this it never sees it. The webhooks keep their own key and stay open.
	# No such file (another server): no password, as before.
	import /etc/caddy/auth/n8n*.caddy
	reverse_proxy n8n:5678
}
